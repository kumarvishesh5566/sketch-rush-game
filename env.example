# Server Port
PORT=3000

# MongoDB Connection String (Atlas Cluster)
MONGODB_URI="mongodb+srv://<db_user>:<db_password>@<your-cluster>.mongodb.net/sketchrush?retryWrites=true&w=majority"

# Application URL
APP_URL="http://localhost:3000"

# Optional: Separate Frontend & Backend Deployment
# When deploying Frontend (Vercel/Netlify) and Backend (Render/Railway) separately,
# set this on the Frontend deployment to point to your backend URL:
# VITE_BACKEND_URL="https://your-backend-app.onrender.com"
